{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oosr.dev/schema/v0/object.json",
  "title": "OOSR Object Description",
  "type": "object",
  "required": ["id", "type", "skills"],
  "properties": {
    "@context": { "const": "https://oosr.dev/ns/v0" },
    "id": { "type": "string", "pattern": "^urn:oosr:obj:[a-z0-9-]+:[0-9a-f-]{36}$" },
    "type": { "$ref": "#/$defs/objectType" },
    "name": { "type": "string", "maxLength": 120 },
    "location": {
      "type": "object",
      "properties": {
        "zone": { "type": "string", "pattern": "^[a-z0-9_-]{1,64}$" },
        "pose": { "$ref": "#/$defs/pose" }
      },
      "additionalProperties": false
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref"],
        "properties": {
          "ref": { "type": "string", "pattern": "^skill:[a-z0-9.-]+(/[a-z0-9._-]+)*/[a-z0-9-]+$" },
          "min_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" }
        },
        "additionalProperties": false
      }
    },
    "attributes": { "type": "object" },
    "bindings": {
      "type": "array",
      "items": { "$ref": "https://oosr.dev/schema/v0/binding.json" }
    }
  },
  "$defs": {
    "objectType": { "type": "string", "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)*$", "maxLength": 200 },
    "pose": {
      "type": "object",
      "required": ["frame", "xyz"],
      "properties": {
        "frame": { "type": "string" },
        "xyz": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
        "quat": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 }
      },
      "additionalProperties": false
    }
  }
}
