{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oosr.dev/schema/v0/policy.json",
  "title": "OOSR Home Policy",
  "type": "object",
  "required": ["trusted_publishers"],
  "properties": {
    "trusted_publishers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^did:web:" }
    },
    "robots": {
      "type": "object",
      "propertyNames": { "pattern": "^urn:oosr:robot:[a-z0-9-]+:[A-Za-z0-9._-]+$" },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "write": { "type": "array", "items": { "type": "string", "pattern": "^oosr\\.[a-z0-9_.*]+$" } },
          "zones": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9_-]{1,64}$" } }
        },
        "additionalProperties": false
      }
    },
    "always_require_approval": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z_]+(:[a-z_]+)?$" }
    },
    "quiet_hours": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "to": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
      },
      "additionalProperties": false
    },
    "timezone": { "type": "string", "description": "IANA zone used for quiet_hours and season. Defaults to the hub's system zone." },
    "hemisphere": { "enum": ["north", "south"], "description": "Skill seasons are written for the northern hemisphere; south shifts them by 6 months." },
    "trusted_manufacturers": {
      "type": "object",
      "description": "Robot URN vendor segment -> did:web of the manufacturer that issues its device certificates.",
      "propertyNames": { "pattern": "^[a-z0-9-]+$" },
      "additionalProperties": { "type": "string", "pattern": "^did:web:" }
    },
    "require_device_cert": { "type": "boolean", "description": "Refuse to pair robots without a valid device certificate." }
  },
  "additionalProperties": false
}
